# ==============================================================================
# Early Disease Risk Prediction Using Explainable Machine Learning
# Template Environment Configuration (.env.example)
# Copy this file to .env and customize with your local secrets/credentials.
# ==============================================================================

# Application Metadata
APP_NAME="Early Disease Risk Prediction Using Explainable Machine Learning"
APP_ENV=development
APP_VERSION=1.0.0

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/disease_risk_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=disease_risk_db

# Frontend Client Configuration
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api

# Local Explainable LLM Service (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_REQUEST_TIMEOUT=75
