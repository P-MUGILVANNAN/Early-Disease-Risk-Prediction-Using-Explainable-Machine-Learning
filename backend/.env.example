# ==============================================================================
# Backend Configuration Template (.env.example)
# Copy to .env and configure your local credentials.
# ==============================================================================
APP_NAME="Early Disease Risk Prediction API"
APP_ENV=development
APP_VERSION=1.0.0

# Local MySQL Database Connection
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/disease_risk_db

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Local LLM / Ollama Explainability Service
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
